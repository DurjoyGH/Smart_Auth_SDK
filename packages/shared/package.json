{
  "name": "@smart-auth/shared",
  "version": "0.1.1",
  "description": "Shared utilities for Smart Auth SDK — JWT decoding, event emitter, environment detection, and logging",
  "license": "MIT",
  "author": "Durjoy Ghosh",
  "repository": {
    "type": "git",
    "url": "https://github.com/DurjoyGH/Smart_Auth_SDK.git",
    "directory": "packages/shared"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smart-auth/types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "keywords": [
    "auth",
    "jwt",
    "decode",
    "event-emitter",
    "utilities",
    "smart-auth",
    "logger"
  ],
  "homepage": "https://github.com/DurjoyGH/Smart_Auth_SDK/tree/main/packages/shared#readme"
}
