{
  "name": "@smart-auth/axios",
  "version": "0.1.2",
  "description": "Axios integration for Smart Auth SDK — automatic token injection, 401 interceptors, and silent refresh with request queuing",
  "license": "MIT",
  "author": "Durjoy Ghosh",
  "repository": {
    "type": "git",
    "url": "https://github.com/DurjoyGH/Smart_Auth_SDK.git",
    "directory": "packages/axios"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smart-auth/types": "workspace:*",
    "@smart-auth/core": "workspace:*",
    "@smart-auth/shared": "workspace:*"
  },
  "peerDependencies": {
    "axios": ">=1.0.0"
  },
  "devDependencies": {
    "axios": "^1.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "keywords": [
    "auth",
    "axios",
    "interceptor",
    "jwt",
    "token-refresh",
    "smart-auth",
    "retry-queue",
    "authentication"
  ],
  "homepage": "https://github.com/DurjoyGH/Smart_Auth_SDK/tree/main/packages/axios#readme"
}
