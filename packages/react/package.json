{
  "name": "@smart-auth/react",
  "version": "0.1.2",
  "description": "React integration for Smart Auth SDK — AuthProvider, useAuth hook, protected routes, and role-based UI guards",
  "license": "MIT",
  "author": "Durjoy Ghosh",
  "repository": {
    "type": "git",
    "url": "https://github.com/DurjoyGH/Smart_Auth_SDK.git",
    "directory": "packages/react"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smart-auth/types": "workspace:*",
    "@smart-auth/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "jsdom": "^24.0.0"
  },
  "keywords": [
    "auth",
    "react",
    "hooks",
    "authentication",
    "jwt",
    "protected-routes",
    "smart-auth",
    "useAuth",
    "context"
  ],
  "homepage": "https://github.com/DurjoyGH/Smart_Auth_SDK/tree/main/packages/react#readme"
}
