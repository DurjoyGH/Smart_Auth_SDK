{
  "name": "@smart-auth/fetch",
  "version": "0.1.2",
  "description": "Fetch API wrapper for Smart Auth SDK — automatic token injection, 401 handling, and silent refresh with retry",
  "license": "MIT",
  "author": "Durjoy Ghosh",
  "repository": {
    "type": "git",
    "url": "https://github.com/DurjoyGH/Smart_Auth_SDK.git",
    "directory": "packages/fetch"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smart-auth/types": "workspace:*",
    "@smart-auth/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "keywords": [
    "auth",
    "fetch",
    "jwt",
    "token-refresh",
    "smart-auth",
    "authentication",
    "fetch-wrapper"
  ],
  "homepage": "https://github.com/DurjoyGH/Smart_Auth_SDK/tree/main/packages/fetch#readme"
}
